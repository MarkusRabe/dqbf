-- Collatz succinct DQBF: trajectory f(x,.) over 2^12-1 steps reaches 1?
-- ∃f. ∀x,t. f(x,0)=x ∧ transition ∧ (t=max → f(x,t)=1). SAT iff bound suffices.
param N = 24
param K = 12
fun f : bv[N], bv[K] -> bv[N]
forall x : bv[N]
forall t : bv[K]
x == f(x, 0)
((t + 1) != 0) -> (f(x, t + 1) == ite(f(x, t) <= 1, (f(x, t) & 0) + 1, ite((f(x, t) & 1) == 0, f(x, t) >>> 1, 3 * f(x, t) + 1)))
((t + 1) == 0) -> ((x == 0) || (f(x, t) == 1))
