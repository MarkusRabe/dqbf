-- Collatz unrolled BMC: every nonzero 24-bit start reaches 1 in <= 12 steps?
-- SAT iff yes (UNSAT expected for small K -- many starts need more steps).
param N = 24
forall x : bv[N]
exists s0 : bv[N]
exists s1 : bv[N]
exists s2 : bv[N]
exists s3 : bv[N]
exists s4 : bv[N]
exists s5 : bv[N]
exists s6 : bv[N]
exists s7 : bv[N]
exists s8 : bv[N]
exists s9 : bv[N]
exists s10 : bv[N]
exists s11 : bv[N]
exists s12 : bv[N]
s0 == x
s1 == ite(s0 <= 1, (s0 & 0) + 1, ite((s0 & 1) == 0, s0 >>> 1, 3 * s0 + 1))
s2 == ite(s1 <= 1, (s1 & 0) + 1, ite((s1 & 1) == 0, s1 >>> 1, 3 * s1 + 1))
s3 == ite(s2 <= 1, (s2 & 0) + 1, ite((s2 & 1) == 0, s2 >>> 1, 3 * s2 + 1))
s4 == ite(s3 <= 1, (s3 & 0) + 1, ite((s3 & 1) == 0, s3 >>> 1, 3 * s3 + 1))
s5 == ite(s4 <= 1, (s4 & 0) + 1, ite((s4 & 1) == 0, s4 >>> 1, 3 * s4 + 1))
s6 == ite(s5 <= 1, (s5 & 0) + 1, ite((s5 & 1) == 0, s5 >>> 1, 3 * s5 + 1))
s7 == ite(s6 <= 1, (s6 & 0) + 1, ite((s6 & 1) == 0, s6 >>> 1, 3 * s6 + 1))
s8 == ite(s7 <= 1, (s7 & 0) + 1, ite((s7 & 1) == 0, s7 >>> 1, 3 * s7 + 1))
s9 == ite(s8 <= 1, (s8 & 0) + 1, ite((s8 & 1) == 0, s8 >>> 1, 3 * s8 + 1))
s10 == ite(s9 <= 1, (s9 & 0) + 1, ite((s9 & 1) == 0, s9 >>> 1, 3 * s9 + 1))
s11 == ite(s10 <= 1, (s10 & 0) + 1, ite((s10 & 1) == 0, s10 >>> 1, 3 * s10 + 1))
s12 == ite(s11 <= 1, (s11 & 0) + 1, ite((s11 & 1) == 0, s11 >>> 1, 3 * s11 + 1))
(x == 0) || (s0 == 1) || (s1 == 1) || (s2 == 1) || (s3 == 1) || (s4 == 1) || (s5 == 1) || (s6 == 1) || (s7 == 1) || (s8 == 1) || (s9 == 1) || (s10 == 1) || (s11 == 1) || (s12 == 1)
