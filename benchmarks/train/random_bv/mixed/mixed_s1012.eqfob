-- random_bv seed=1012 mode=mixed width=2
param N = 2

fun f0 : bv[N] -> bv[N]
fun f1 : bv[N] -> bv[N]

forall x0 : bv[N]
forall x1 : bv[N]

(((f1(x1) ^ f0(x1)) + 3) >= (x1 ^ f1(x0)))
((((f0(x1) & x0) | (x0 & x0)) == ((x1 | x0) & ~f0(x0))) && (f1(x1) >= ~x0))
((((x1 & f1(x1)) & (f1(x1) ^ f1(x0))) <= ((x1 & 3) ^ ~x1)) || (((x1 + f1(x0)) & (x1 + x0)) >= (f0(x1) + f0(x1))))
