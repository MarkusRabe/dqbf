-- random_bv seed=20000 mode=mixed width=8
param N = 8

fun f0 : bv[N] -> bv[N]
fun f1 : bv[N] -> bv[N]

forall x0 : bv[N]
forall x1 : bv[N]

(((x0 & (x1 | x1)) <= x0) || (~x1 != ~x0))
((f1(x1) > (x1 | (x1 ^ 70))) || (f1(x1) != x1))
((~f1(x0) ^ f0(x0)) < ((x1 + 173) ^ (x1 + 4)))
((f0(x0) + ~f1(x1)) > f0(x1))
