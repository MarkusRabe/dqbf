-- random_bv seed=20007 mode=mixed width=8
param N = 8

fun f0 : bv[N] -> bv[N]
fun f1 : bv[N] -> bv[N]

forall x0 : bv[N]

((x0 < ~f1(x0)) || (x0 <= f1(x0)))
(((x0 + (f1(x0) | f0(x0))) < x0) && (f1(x0) > ~x0))
((x0 ^ ~f1(x0)) > f1(x0))
((x0 != (~x0 + f1(x0))) || (((f1(x0) & f1(x0)) + (f0(x0) | x0)) > f0(x0)))
