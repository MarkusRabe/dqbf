-- random_bv seed=11 mode=under width=2
param N = 2

fun f0 : bv[N] -> bv[N]

forall x0 : bv[N]
forall x1 : bv[N]

(((f0(x0) + (x0 & 2)) > (x1 + ~x0)) && (((f0(x1) & x0) & (x1 | f0(x1))) <= ((x0 + x1) ^ f0(x0))))
((((x1 + f0(x1)) + 0) == (f0(x1) ^ x1)) || (((f0(x0) + 3) & 1) >= ((x1 + f0(x0)) & (f0(x0) & f0(x1)))))
