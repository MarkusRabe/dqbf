-- random_bv seed=2000 mode=over width=2
param N = 2

fun f0 : bv[N] -> bv[N]
fun f1 : bv[N] -> bv[N]

forall x0 : bv[N]

((f1(x0) == ((x0 | x0) & f0(x0))) && (x0 < ~f0(x0)))
((((f1(x0) + f1(x0)) ^ 0) > ((f0(x0) & x0) & ~x0)) && (((x0 ^ 2) & (x0 + 1)) > x0))
(((f1(x0) + 1) >= ~x0) || (((f0(x0) + f1(x0)) | ~x0) <= ~x0))
((f1(x0) ^ x0) > f1(x0))
(~f0(x0) < x0)
((((f0(x0) + x0) ^ (f1(x0) + x0)) != ((f0(x0) + f0(x0)) | 1)) && (f1(x0) < ~x0))
